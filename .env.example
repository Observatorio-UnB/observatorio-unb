POSTGRES_USER=observatorio
POSTGRES_PASSWORD=observatorio
POSTGRES_DB=observatorio
POSTGRES_PORT=5435
PAINEL_PORT=8501

# URL usada pelos scripts rodando fora do Docker (.venv). É o banco local do pipeline:
# não aponte para o Supabase (bronze e silver têm dado pessoal).
DATABASE_URL=postgresql://observatorio:observatorio@localhost:5435/observatorio

# Destino da última etapa do pipeline (src/db/sincronizar_supabase.py): recebe só a gold e a
# busca semântica, de forma incremental. Vazia, a etapa é pulada.
SUPABASE_DATABASE_URL=

# Destino do ETL reverso (src/etl_reverso/fila_intervencao.py): onde fica a fila de intervenção que a
# coordenação e o DEG operam. Vazia, a fila fica neste mesmo banco (esquema operacional). Num destino
# novo, rode uma vez com --preparar-destino.
ETL_REVERSO_DATABASE_URL=

# Chat com LLM local (src/chat, página Chat do painel). O usuário observatorio_chat vem da migração 0033 (a senha vem desta URL e é aplicada por src/db/migrar.py):
# só lê gold, busca e dbt_marts. Nunca aponte para o Supabase.
CHAT_DATABASE_URL=postgresql://observatorio_chat:observatorio_chat@localhost:5435/observatorio
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=900
# Cluster/servidor remoto de LLM (API do Ollama): troque OLLAMA_URL e, se exigir, informe a chave (Bearer).
# Os resultados das consultas vão a esse servidor: use só infraestrutura da instituição.
# No docker compose use OLLAMA_URL_REMOTO (OLLAMA_URL acima vale só fora do Docker; no container seria o localhost errado).
OLLAMA_URL_REMOTO=
OLLAMA_API_KEY=
# Senha do usuário do chat no docker compose (o padrão é só de desenvolvimento).
CHAT_DB_PASSWORD=observatorio_chat
