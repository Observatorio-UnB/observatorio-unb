POSTGRES_USER=observatorio
POSTGRES_PASSWORD=observatorio
POSTGRES_DB=observatorio
POSTGRES_PORT=5435
PAINEL_PORT=8501

# URL usada pelos scripts rodando fora do Docker (.venv). É o banco local do pipeline:
# não aponte para o Supabase (bronze e silver têm dado pessoal).
DATABASE_URL=postgresql://observatorio:observatorio@localhost:5435/observatorio

# Destino da última etapa do pipeline (src/db/sincronizar_supabase.py): recebe só a gold e a
# busca semântica, de forma incremental. Vazia, a etapa é pulada.
SUPABASE_DATABASE_URL=

# Chat com LLM local (src/chat, página Chat do painel). O usuário observatorio_chat vem da migração 0027:
# só lê gold, busca e dbt_marts. Nunca aponte para o Supabase.
CHAT_DATABASE_URL=postgresql://observatorio_chat:observatorio_chat@localhost:5435/observatorio
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
