# Copie para .env e ajuste se precisar. Todos têm valor padrão.

# Banco local (docker compose)
POSTGRES_USER=observatorio
POSTGRES_PASSWORD=observatorio
POSTGRES_DB=observatorio
POSTGRES_PORT=5435
PAINEL_PORT=8501

# URL usada pelos scripts rodando fora do Docker (.venv).
# O pipeline grava bronze e silver (dado pessoal) nesta URL: prefira um banco local
# ou restrito a um banco hospedado por terceiros (ex.: Supabase).
DATABASE_URL=postgresql://observatorio:observatorio@localhost:5435/observatorio
