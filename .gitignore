# Ambientes Virtuais Python
venv/
.venv/
env/
ENV/

# Caches e arquivos temporários do Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/

# Arquivos do Sistema Operacional
.DS_Store
Thumbs.db

# O pipeline grava as camadas no PostgreSQL. data/ é resto da versão em CSV, e o
# export da gold para o GitHub Pages é gerado pelo CI (src/db/exportar_gold.py).
data/*
!data/bronze/
data/bronze/*
!data/bronze/cnpq_valor_bolsa_ic.json
# A série do valor da bolsa de IC é a única entrada de dados versionada (ADR 0023).
export/

# IDEs e configurações locais
.vscode/
.idea/
*.log

# Configuração local e cache do modelo de embedding (~240 MB)
.env
.cache/

# Documentação interna de arquitetura e planejamento
.blueprint/

# Agentes de IA e skills locais
.agents/


# Instância temporária do Dagster criada pelo `dagster dev` (orquestracao/)
.tmp_dagster_home*/
